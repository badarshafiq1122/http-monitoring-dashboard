# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://dev:postgres@localhost:5433/bizscout
# Individual DB params (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizscout
DB_USER=postgres
DB_PASSWORD=postgres

# Polling Configuration
POLL_INTERVAL_MINUTES=5
TARGET_URL=https://httpbin.org/anything

# Anomaly Detection Configuration
ANOMALY_WINDOW_HOURS=24
ANOMALY_Z_SCORE_THRESHOLD=2.5

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
